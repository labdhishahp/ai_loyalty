# Server-side only. Neither BACKEND_ variable is prefixed NEXT_PUBLIC_, because
# that prefix is what compiles a value into the browser bundle -- and
# BACKEND_API_KEY is the shared secret protecting the API.

# The API's own origin. The frontend and the Python API deploy as TWO separate
# Vercel projects (see docs/deployment.md), so this is a different host in
# production, and the dev server locally.
#
# There is no default in production on purpose: a silent fallback to localhost
# would make a missing variable look like the API being down.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=SAME_VALUE_AS_APP_API_KEY_IN_THE_ROOT_ENV

# Public by design: the anon key identifies the project, not a user. Every
# request is still authorised server-side by the token the browser presents.
#
# READ AT BUILD TIME. Next.js compiles these into the bundle, so setting them
# after a deploy does nothing until the next build. next.config.ts refuses a
# production build without them rather than shipping sign-in silently disabled.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
