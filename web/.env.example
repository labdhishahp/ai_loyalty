# Server-side only. Neither is prefixed NEXT_PUBLIC_, because that prefix is
# what compiles a value into the browser bundle -- and BACKEND_API_KEY is the
# shared secret protecting the API.
#
# On Vercel the Python API deploys into the same project, so BACKEND_URL points
# at the deployment's own origin.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=SAME_VALUE_AS_APP_API_KEY_IN_THE_ROOT_ENV
