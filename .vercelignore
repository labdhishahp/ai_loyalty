# ONE project builds both halves from this directory: Next.js from app/, lib/
# and components/, and the Python function from api/ plus core/, agent/,
# tools/, llm/, knowledge/, actions/, metrics/ and mcp_server/.
#
# So nothing either half needs may be listed here. What remains is laptop-only
# tooling and test data, which only enlarges the upload. A test
# (test_requirements_covers_every_runtime_import) walks the real import graph
# of the runtime packages, so this list cannot quietly drop something the
# function needs.

# SECRETS FIRST. `vercel build` puts every project file into the function's
# upload manifest, and a local .env landed in it -- 10,601 files, including
# real credentials. Nothing here is loaded at runtime on Vercel anyway:
# environment variables come from the platform, and core/config.py's
# load_dotenv() is a no-op when the file is absent.
.env
.env.*
!.env.example

tests/
docs/
eval/
seed/
scripts/
db/migrations/
.venv/
.venv312/
.pytest_cache/
*.egg-info/
uv.lock
.vercel_python_packages/

# Generated seed data. Large, regenerable, and never read at runtime -- the
# corpus the API queries lives in Postgres, not on disk.
seed/out/
