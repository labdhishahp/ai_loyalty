# Build output and dependencies
node_modules/
.next/
out/
.vercel/
tsconfig.tsbuildinfo

# Written by `vercel build` / uv on every run, derived from pyproject.toml's
# requires-python. Regenerated each build, so committing them only creates
# drift between the file and the field that actually decides the version.
.python-version
uv.lock

# Written by `vercel build`: the Python dependency tree it installs for the
# function bundle. Regenerated every build, ~850k lines, and never a source of
# truth -- pyproject.toml and requirements.txt are.
.vercel_python_packages/
