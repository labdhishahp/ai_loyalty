# Supabase -> Project Settings -> Database -> Connection string

# Direct connection (port 5432). Used for migrations and the seed COPY load:
# both need a real session, and COPY is far faster without a pooler in between.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Transaction pooler (port 6543). Not used yet -- the API layer will use this,
# because serverless functions open many short-lived connections.
# DATABASE_POOL_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres
