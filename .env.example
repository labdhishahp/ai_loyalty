# Template for .env — SAFE TO COMMIT. Variable names only, never real values.
#
#   cp .env.example .env    then fill in the values you need
#
# Grouped by the milestone that first needs them, so you can fill it in as you
# go rather than all at once. Anything marked OPTIONAL has a working default in
# code; it is listed here so the knob is discoverable, not because it must be set.
#
# NOTHING IN THIS FILE REACHES A BROWSER except the three NEXT_PUBLIC_* values at
# the bottom, which are public by design. Every other value is server-side only.


# ============================================================================
# Database — needed now (slices 1.1 onward)
# ============================================================================

# DIRECT connection, port 5432. Used by db/migrate.py, seed/load.py,
# seed/verify.py and the test suite. COPY and migrations need a real session,
# which a pooler cannot give them.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Direct
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# TRANSACTION POOLER, port 6543. Used by the API layer from slice 1.5 onward.
# This is not a preference: the database allows 60 connections, and serverless
# functions scale to many short-lived instances. Direct connections from the API
# would exhaust the limit under trivial load.
# Same page -> Connection string -> Transaction pooler
#
# Two things handled for you in core/db.py, so paste whichever form the
# dashboard gives you:
#   * Supabase's Prisma tab appends `?pgbouncer=true`. libpq has no such
#     parameter and psycopg rejects the whole URI. It is stripped.
#   * Transaction pooling hands a connection to a different client between
#     statements, so prepared statements are disabled. psycopg3 otherwise starts
#     preparing after the fifth identical execution -- meaning this would break
#     only once a query became common.
#
# Supabase's Prisma tab also produces a DIRECT_URL (the SESSION pooler, port
# 5432). That is a Prisma convention; this project does not use it. Harmless to
# leave in .env, and nothing reads it.
DATABASE_POOL_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres


# ============================================================================
# Language model — needed from slice 1.5 (the agent loop)
# ============================================================================

# Which provider the agent uses: anthropic | coe. Defaults to anthropic in code.
# The agent loop, the trace and the eval never learn which one answered; every
# run records the provider and model that produced it, so the two can be
# compared on identical questions later.
# LLM_PROVIDER=anthropic

# REQUIRED to run an investigation.
ANTHROPIC_API_KEY=YOUR_KEY_HERE
# ANTHROPIC_MODEL=claude-opus-5

# COE AI Gateway — OpenAI-compatible endpoint serving Qwen. COMMENTED OUT, and
# that is the honest state of it: the gateway's base URL and model id were
# never discovered, so llm/openai_compatible.py has never made a live call.
# Its translation layer is tested against a fake gateway; the transport is not.
# See docs/coe-gateway-investigation.md.
#
# This block used to be uncommented with LLM_PROVIDER=coe above it, which meant
# anyone copying the template configured a provider that cannot answer.
#
# COE_BASE_URL must be the base that ends in /v1 (the SDK appends the path).
# COE_MODEL must be the EXACT model id the gateway expects; aliases differ
# between gateways and a wrong string fails at the first call.
# COE_BASE_URL=https://YOUR-GATEWAY-HOST/v1
# COE_API_KEY=YOUR_KEY_HERE
# COE_MODEL=YOUR_MODEL_ID_HERE

# Cost/quality lever on this model family: low | medium | high.
# ANTHROPIC_EFFORT=medium


# ============================================================================
# Agent safety and budgets — OPTIONAL, all have defaults in code
# ============================================================================
# These exist so a development run cannot loop indefinitely or quietly spend a
# fortune. The token ceiling is the primary control; cost is secondary because a
# self-hosted gateway may have no per-token price at all.

# Hard ceiling on agent turns in one run. The loop stops and reports rather than
# continuing, so a run that is going nowhere ends visibly instead of silently.
# AGENT_MAX_STEPS=18

# Cumulative tokens (input + output) across all turns of one run.
# AGENT_MAX_RUN_TOKENS=400000

# Cumulative cost ceiling in USD. Only enforced for providers with known
# pricing; ignored when the provider does not publish per-token rates.
# AGENT_MAX_RUN_COST_USD=5.00

# Global kill switch. Set to false and no new run will start, regardless of
# anything else. Intended for "stop everything now" rather than tuning.
# AGENT_ENABLED=true

# How long ONE model call may take. Must stay below vercel.json's maxDuration
# (60s), so that a slow turn fails as a recorded error rather than being killed
# mid-call by the platform with the tokens already spent. Measured turns: mean
# 11.1s, p95 24.6s, slowest 37.0s. Raise this only together with maxDuration.
# LLM_TIMEOUT_SECONDS=50

# Per-actor rate limits, counted over a trailing hour against rows that already
# exist (ops.agent_runs, ops.campaign_proposals) -- there is no counter table.
# The budgets above cap what ONE run may spend; these cap how many runs one
# caller may start, which is what actually bounds a bill. Set to 0 to disable.
# RATE_LIMIT_RUNS_PER_HOUR=20
# RATE_LIMIT_PROPOSALS_PER_HOUR=10


# ============================================================================
# Embeddings — needed from Milestone 2 (knowledge retrieval)
# ============================================================================

# Retry budget for embedding calls. The overall budget bounds the WHOLE call,
# not each attempt, so a cold model cannot consume a request's entire life:
# attempts stop when the budget is gone and each is capped at what remains.
# Must stay below maxDuration. `python -m knowledge.ingest` raises both on its
# own, because on a laptop a cold start is worth waiting out.
# EMBEDDING_TIMEOUT_SECONDS=15
# EMBEDDING_BUDGET_SECONDS=30

# Provider for new documents. The model that indexed a document is recorded with
# it and always used to query it: vectors from different models are not
# comparable, and mixing them in one index silently degrades every result.
# EMBEDDING_PROVIDER=huggingface

# OPTIONAL override of the model. Dimension is derived from the model in code,
# never configured separately, so the two cannot drift apart.
# Default: BAAI/bge-small-en-v1.5 (384-d).
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Hugging Face token — REQUIRED once Milestone 2 starts. "read" scope is enough
# for inference. https://huggingface.co/settings/tokens
HF_TOKEN=YOUR_TOKEN_HERE


# ============================================================================
# API — needed from slice 1.6 (first deployment)
# ============================================================================

# Shared secret required in an X-API-Key header. Until Milestone 4 adds real
# authentication there is nothing else protecting a deployed API, and a public
# endpoint that runs model calls is an open invitation to spend your gateway
# quota. Unset is tolerated locally; a deployed instance refuses to start
# without it.
APP_API_KEY=GENERATE_A_LONG_RANDOM_STRING


# ============================================================================
# Authentication — needed from Milestone 4 (approval workflow)
# ============================================================================
# Supabase Auth is already provisioned in the project, so identity comes from
# there rather than being hand-rolled.

# REQUIRED BY THE DEPLOYED API, and required to IMPORT it, not merely to serve
# a request: api/app.py builds the MCP server at module scope and that calls
# require("SUPABASE_URL"). Without it the function fails to import and every
# route returns 500, including /api/health.
SUPABASE_URL=https://PROJECT.supabase.co

# The origin this API is reachable at, used for the MCP resource-server URL
# advertised to clients. It defaults to http://localhost:8000, which is correct
# on a laptop and wrong on a deployment -- a deployed server would otherwise
# tell every MCP client to authenticate against localhost.
# PUBLIC_BASE_URL=https://lmart-api.vercel.app

# SERVICE ROLE KEY — BYPASSES ROW LEVEL SECURITY.
# Server-side only, never in a browser bundle, never in a NEXT_PUBLIC_ variable.
#
# NOT a Vercel variable. The only thing that reads it is scripts/users.py, the
# administrative CLI for granting roles, which is run from a laptop against the
# direct connection. The deployed API never uses it, and giving a deployment a
# key that bypasses RLS it has no use for is how blast radius grows quietly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE


# ============================================================================
# Frontend (Next.js) — needed from slice 1.6 (trace viewer)
# ============================================================================

# These belong in web/.env.local (and in the FRONTEND Vercel project), not here
# — the frontend deploys as a separate project. Listed for completeness because
# two of them must match values above.
#
# The browser never reaches the Python API directly. It calls the Next.js route
# handler at /api/proxy/*, which holds the secret and forwards. BACKEND_URL is
# where that handler forwards to: the API deployment's origin.
# BACKEND_URL=https://lmart-api.vercel.app

# Server-side copy of APP_API_KEY, used by Next.js route handlers calling the
# API. Deliberately NOT prefixed NEXT_PUBLIC_ — it must not reach the browser.
# BACKEND_API_KEY=SAME_VALUE_AS_APP_API_KEY

# NEXT_PUBLIC_* values ARE bundled into the browser. That is correct for these
# two: the anon key is designed to be public and is constrained by row level
# security. The service role key must never appear here.
#
# THEY ARE READ AT BUILD TIME, NOT AT RUNTIME. Next.js compiles the value into
# the bundle, so setting them after a deploy changes nothing until the next
# build. Absent during the build, the frontend ships with sign-in permanently
# disabled. web/next.config.ts refuses a production build without them.
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ============================================================================
# MCP — optional, only affects the stdio server
# ============================================================================
# Over stdio the client launched this process on this machine, so the operating
# system has already established who you are and there is no token to check.
# Identity therefore comes from here, and defaults to READ ONLY: raising it is a
# deliberate act, not something that happens by accident.
#
# Over HTTP none of these apply — the bearer token decides, verified exactly as
# the REST API verifies it.
#
# MCP_HTTP_ENABLED turns the mounted /mcp endpoint off without affecting the
# REST API. Default true. On Vercel the transport is automatically stateless,
# because serverless instances have no session affinity.
# MCP_HTTP_ENABLED=true
# MCP_ACTOR=your-name-laptop
# MCP_ROLE=analyst            # analyst | approver
# MCP_ALLOW_WRITES=false      # true lets a local session draft proposals
